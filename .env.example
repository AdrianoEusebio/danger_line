# =============================================================================
# DANGER LINE v2 — Environment Variables
# Copie este arquivo: cp .env.example .env
# Nunca commite o .env com suas chaves reais
# =============================================================================

# -----------------------------------------------------------------------------
# PROVIDERS — IA Base (gratuita)
# -----------------------------------------------------------------------------

# Groq API Key (provider primário)
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Gemini API Key (fallback do Groq)
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama (fallback local — opcional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# -----------------------------------------------------------------------------
# KNOWLEDGE BASE — Obsidian Vault
# -----------------------------------------------------------------------------

# Path absoluto do vault do Obsidian (OBRIGATÓRIO)
# Windows: use barras normais /
OBSIDIAN_VAULT_PATH=C:/Users/adria/OneDrive/Documentos/Danger_line/Danger Line

# -----------------------------------------------------------------------------
# WORKSPACE
# -----------------------------------------------------------------------------

# Path dos seus projetos
PROJECTS_PATH=C:/Users/adria/OneDrive/Área de Trabalho/PROJETOS

# Projeto ativo por padrão (pode ser trocado via MCP set_workspace)
DEFAULT_WORKSPACE_PATH=

# -----------------------------------------------------------------------------
# COMPORTAMENTO DO SISTEMA
# -----------------------------------------------------------------------------

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Timeout para providers (segundos)
PROVIDER_TIMEOUT_SECONDS=30

# Modo debug (desativa cache para facilitar testes)
DEBUG_MODE=false
