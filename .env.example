# =============================================================================
# DANGER LINE v3.0 — Ecossistema de Inteligência Agnóstico
# Copie este arquivo para .env: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 🤖 AI PROVIDERS (Agnóstico)
# -----------------------------------------------------------------------------

# Google Gemini (Recomendado para Sanitização e Destilação)
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=seu-api-key-aqui

# Groq (Fallback de Alta Performance)
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=seu-api-key-aqui

# Ollama (Processamento Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# 📓 KNOWLEDGE BASE (Obsidian Vault)
# -----------------------------------------------------------------------------

# Caminho absoluto para a pasta do seu Vault (OBRIGATÓRIO)
# Exemplo Windows: C:/Users/Nome/Documents/MeuVault
OBSIDIAN_VAULT_PATH=C:/Users/adria/OneDrive/Documentos/Danger_line/Danger Line

# Obsidian Local REST API (Para buscas e comandos remotos)
# Habilite o plugin "Local REST API" no Obsidian para obter a chave
OBSIDIAN_API_URL=http://localhost:27123
OBSIDIAN_API_KEY=sua-chave-api-do-plugin-aqui

# -----------------------------------------------------------------------------
# ⚙️ CONFIGURAÇÕES DO SISTEMA
# -----------------------------------------------------------------------------

# Nível de Log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Timeout de Requisições (segundos)
TIMEOUT_SECONDS=30
